# ----------------------------------------------------------------------------
# Vanilla Pterodactyl Native — panel environment template
#
# The installer copies this file to .env and rewrites the DB_ block, then
# `php artisan key:generate --force` fills APP_KEY. HASHIDS_SALT is generated
# by the installer (32 hex chars). Never commit a real .env or real secrets.
# ----------------------------------------------------------------------------

APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://127.0.0.1
# Keep the panel's own timezone handling on UTC internally; the UI renders
# user-facing times per account. Change only if you know you need it.
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=en
APP_ENVIRONMENT_ONLY=true
APP_NAME="Pterodactyl"

LOG_CHANNEL=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=panel
DB_USERNAME=pterodactyl
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Pterodactyl"

# Generated by the installer (openssl rand -hex 32). Must be unique per install.
HASHIDS_SALT=
HASHIDS_LENGTH=8
HASHIDS_ALPHABET=abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890

TRUSTED_PROXIES=

# ----------------------------- optional drivers -----------------------------
# Redis (only needed if you switch CACHE_STORE/SESSION_DRIVER/QUEUE to redis):
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=null

# reCAPTCHA on login (disabled by default):
RECAPTCHA_ENABLED=false
# RECAPTCHA_WEBSITE_KEY=
# RECAPTCHA_SECRET_KEY=

# Backups default to the local daemon (s3 optional):
APP_BACKUP_DRIVER=wings
# AWS_BACKUPS_BUCKET=
# AWS_DEFAULT_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
